# Copy to .env and fill in. Never commit .env.

# Twitch application (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
# Prefer the file form in Docker (compose secret); the plain form is for local dev.
# TWITCH_CLIENT_SECRET=
TWITCH_CLIENT_SECRET_FILE=/run/secrets/twitch_client_secret
# Twitch user ID of the bot account; tokens for any other account are rejected at /auth/callback.
TWITCH_BOT_ID=

# Comma-separated Twitch user IDs with global bot_owner rank (ADR-0006)
BOT_OWNER_IDS=

# Storage (bot.db, chatlog.db, lock file)
DATA_DIR=/data

# Only for a server deploy (compose.prod.yaml): the published image to run, lowercase (ADR-0013).
#BOT_IMAGE=ghcr.io/<owner>/doomtp-bot:main

# REST API / web UI (bind to LAN only; see compose.yaml)
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Must match the OAuth Redirect URL registered on the Twitch app, minus "/auth/callback".
PUBLIC_BASE_URL=http://localhost:8080

# Default command prefix for newly joined channels (spec §2.1)
DEFAULT_PREFIX=🏜

# Admin UI (http://127.0.0.1:8080/admin). Leave both unset to keep it disabled.
#ADMIN_PASSWORD_FILE=./secrets/admin_password

# Chat history backfill (ADR-0008); per-channel opt-in still required
HISTORY_PROVIDER_URL=https://recent-messages.robotty.de/api/v2

LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
